# .env for docker-compose.yml: youless-tig alone, with an InfluxDB 2.x (and
# Grafana) you already run. For the complete stack use .env.stack.example.
#
#   cp .env.example .env && chmod 600 .env
#
# .env holds a token: keep it out of git (it is in .gitignore) and readable only
# by you. Every setting: docs/configuration.md.

# ══ Required ═════════════════════════════════════════════════════════════════

# Address of your YouLess (give it a fixed address in your router).
YOULESS_URL=http://192.168.1.50
# Time zone of the YouLess: its logs carry local times without a zone.
TZ=Europe/Brussels

# Your InfluxDB, its organisation and the bucket for youless-tig.
INFLUX_URL=http://192.168.1.10:8086
INFLUX_ORG=home
INFLUX_BUCKET=youless
# A token with read AND write access to that bucket only, not the admin token
# (docs/influxdb.md). With INFLUX_WRITE_URL below, read access is enough.
INFLUX_TOKEN=

# ══ Optional: the defaults are shown ═════════════════════════════════════════

# Port on the Docker host for the YouLess-compatible API:
# http://<docker host>:8030/e. Inside the container youless-tig always listens
# on 8080; the compose file maps this port to it. Pick any free port.
YOULESS_TIG_PORT=8030
# Interface to publish it on: 0.0.0.0 = whole LAN, 127.0.0.1 = this host only.
YOULESS_TIG_BIND=0.0.0.0
# Image tag; pin a version (e.g. 0.1.0) to update only when you choose.
YOULESS_TIG_VERSION=latest

# Only if you protected the YouLess web interface with a password.
YOULESS_PASSWORD=
# Value of the "device" tag (one container per YouLess).
DEVICE_NAME=youless
# How often to read the live meter values (2s…1h).
POLL_INTERVAL=10s
# auto = electricity, plus gas and water when your smart meter has them.
# Or a list: electricity,gas,water,s0
CHANNELS=auto
# Also store the YouLess's internal logs (minute, 10-minute, hour, day): needed
# for the log pages of the API and to fill gaps after downtime.
HISTORY=true
# debug, info, warn or error
LOG_LEVEL=info

# Send writes to your Telegraf (inputs.influxdb_v2_listener) instead of directly
# to InfluxDB (docs/existing-influxdb.md). Empty: write to INFLUX_URL.
INFLUX_WRITE_URL=
INFLUX_WRITE_TOKEN=
