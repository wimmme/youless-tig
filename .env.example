# youless-tig settings. Copy to .env and fill in; .env holds secrets, so keep it
# out of git (it is in .gitignore) and readable only by you: chmod 600 .env
#
# Both compose files read this file. Lines marked [stack] are only used by
# docker-compose.stack.yml; lines marked [alone] only by docker-compose.yml.
#
# Two kinds of settings:
# - settings youless-tig itself reads: the compose file passes them to the
#   container under "environment:";
# - settings only the compose file uses (marked [compose]): ports, interfaces,
#   image version, the stack's InfluxDB and Grafana settings. youless-tig does
#   not read them: never add them under youless-tig's "environment:".

# ── The YouLess ──────────────────────────────────────────────────────────────
# Address of your YouLess (give it a fixed address in your router).
YOULESS_URL=http://192.168.1.50
# Only if you protected the YouLess web interface with a password.
YOULESS_PASSWORD=
# Time zone of the YouLess: its logs carry local times without a zone.
TZ=Europe/Brussels
# Value of the "device" tag in InfluxDB (one container per YouLess).
DEVICE_NAME=youless
# How often to read the live meter values (2s…1h).
POLL_INTERVAL=10s
# auto = electricity, plus gas and water when your smart meter has them.
# Or a list: electricity,gas,water,s0
CHANNELS=auto
# Also store the YouLess's internal logs (minute, 10-minute, hour, day). Needed
# for the log pages of the compatible API and to fill gaps after downtime.
HISTORY=true
LOG_LEVEL=info

# ── The YouLess-compatible API ───────────────────────────────────────────────
# [compose] Port on the Docker host where the API is reachable, e.g.
# http://<docker host>:8080/e. Inside the container youless-tig always listens
# on 8080; the compose file maps this host port to it ("8030:8080" if you set
# 8030). Pick any free port on your host.
YOULESS_TIG_PORT=8080
# [compose] Interface to publish it on: 0.0.0.0 = whole LAN, 127.0.0.1 = this host only.
YOULESS_TIG_BIND=0.0.0.0
# [compose] Image tag; pin a version (e.g. 1.0.0) for predictable updates.
YOULESS_TIG_VERSION=latest

# ── InfluxDB ─────────────────────────────────────────────────────────────────
INFLUX_ORG=home
INFLUX_BUCKET=youless
# [alone] Your InfluxDB and a token with read AND write access to the bucket
# (docs/influxdb.md). Not the admin token.
INFLUX_URL=http://192.168.1.10:8086
INFLUX_TOKEN=
# [alone] Optional: send writes to your Telegraf (inputs.influxdb_v2_listener)
# instead of directly to InfluxDB; then INFLUX_TOKEN only needs read access.
INFLUX_WRITE_URL=
INFLUX_WRITE_TOKEN=

# ── [stack] [compose] InfluxDB and Grafana of docker-compose.stack.yml ───────
# The admin user, password and retention are used only on the very first start,
# to set up InfluxDB. Generate passwords, e.g.: openssl rand -base64 24
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=
# Empty: keep data forever; or e.g. 520w for ten years.
INFLUXDB_RETENTION=
# InfluxDB web UI: localhost only by default (use an SSH tunnel), or 0.0.0.0.
# Host port → 8086 inside the container. Change it if 8086 is taken on your host.
INFLUXDB_BIND=127.0.0.1
INFLUXDB_PORT=8086

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Grafana: host port → 3000 inside the container. Change it if 3000 is taken.
GRAFANA_BIND=0.0.0.0
GRAFANA_PORT=3000
