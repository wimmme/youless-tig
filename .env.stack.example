# .env for docker-compose.stack.yml: youless-tig with its own Telegraf,
# InfluxDB and Grafana. For an InfluxDB you already run use
# .env.example.
#
#   cp .env.stack.example .env && chmod 600 .env
#
# .env holds passwords: keep it out of git (it is in .gitignore) and readable
# only by you. The stack makes its own InfluxDB tokens: you set none here.
# Every setting: docs/configuration.md.

# ══ Required ═════════════════════════════════════════════════════════════════

# Address of your YouLess (give it a fixed address in your router).
YOULESS_URL=http://192.168.1.50
# Time zone of the YouLess (its logs carry local times without a zone); also
# used by InfluxDB and Grafana.
TZ=Europe/Brussels

# Passwords for the InfluxDB and Grafana admin users. Generate them, e.g.:
#   openssl rand -base64 24
# The InfluxDB password (at least 8 characters) is only used on the very first
# start, when InfluxDB sets itself up; change it later in the InfluxDB UI.
INFLUXDB_ADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# ══ Optional: the defaults are shown ═════════════════════════════════════════

# ── Ports on the Docker host ──
# Each service listens on a fixed port inside its container; these choose the
# port on your Docker host. The defaults avoid the usual 8080, 3000 and 8086,
# which are often taken already. Pick any free ports.
#
#   youless-tig API  http://<docker host>:8030/e  → 8080 in the container
#   Grafana          http://<docker host>:3030    → 3000 in the container
#   InfluxDB UI      http://localhost:8031        → 8086 in the container
YOULESS_TIG_PORT=8030
GRAFANA_PORT=3030
INFLUXDB_PORT=8031
# Interfaces to publish on: 0.0.0.0 = whole LAN, 127.0.0.1 = this host only.
# InfluxDB is local by default (reach it with an SSH tunnel).
YOULESS_TIG_BIND=0.0.0.0
GRAFANA_BIND=0.0.0.0
INFLUXDB_BIND=127.0.0.1

# ── InfluxDB first setup (only used on the very first start) ──
INFLUXDB_ADMIN_USER=admin
INFLUX_ORG=home
INFLUX_BUCKET=youless
# Empty: keep data forever; or e.g. 520w for ten years.
INFLUXDB_RETENTION=

# ── Grafana ──
GRAFANA_ADMIN_USER=admin

# ── youless-tig ──
# Image tag; pin a version (e.g. 0.1.0) to update only when you choose.
YOULESS_TIG_VERSION=latest
# Only if you protected the YouLess web interface with a password.
YOULESS_PASSWORD=
# Value of the "device" tag.
DEVICE_NAME=youless
# How often to read the live meter values (2s…1h).
POLL_INTERVAL=10s
# auto = electricity, plus gas and water when your smart meter has them.
# Or a list: electricity,gas,water,s0
CHANNELS=auto
# Also store the YouLess's internal logs: needed for the API's log pages and to
# fill gaps after downtime.
HISTORY=true
# debug, info, warn or error
LOG_LEVEL=info

# Shorter commands: with this line, plain "docker compose up -d" uses the stack.
# COMPOSE_FILE=docker-compose.stack.yml
